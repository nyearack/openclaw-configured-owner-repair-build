+it.each(["role", "link", "owner", "host", "gateway"] as const)(
+  "preserves configured ownership independently of linked operator %s revocation",
+  async (change) => {
+    await withAdminIngress(
+      async ({ cfg, admins, context, activatePolicy, retire, replaceGatewayContext }) => {
+        const admin = admins[0]!;
+        cfg.commands!.ownerAllowFrom = ["discord:" + admin.identity.senderId];
+        await activatePolicy({});
+        const ctx = await context(admin.identity.senderId);
+        const owner = getCommandOwnerAuthority(ctx)!;
+        expect(owner.recoveryReference?.version).toBe(2);
+        const recovered = await prepareCommandOwnerAuthority(cfg, owner.recoveryReference!);
+        expect(recovered.source).toBe("configured-owner");
+        expect(recovered.isCurrent(cfg)).toBe(true);
+        expect(recovered.operatorProfile).toBeUndefined();
+        const operator = prepareInternalGetReplyOptions(undefined, ctx)?.operatorAuthority;
+        expect(operator?.scopes).toEqual(["operator.admin"]);
+        expect(() => operator!.assertCurrent()).not.toThrow();
+        if (change === "role") {
+          setUserProfileRole(admin.profile.id, "member");
+        }
+        if (change === "link") {
+          unlinkUserChannelIdentity(admin.profile.id, admin.identity);
+        }
+        if (change === "owner") {
+          cfg.commands!.ownerAllowFrom = [];
+        }
+        if (change === "host") {
+          retire();
+        }
+        if (change === "gateway") {
+          replaceGatewayContext();
+        }
+        expect(owner.isCurrent()).toBe(change === "role" || change === "link");
+        expect(() => operator!.assertCurrent()).toThrow();
+      },
+    );
+  },
+);
