+
+it("retains configured linked admin through synthetic child and settled continuation dispatch", async () => {
+  await withAdminIngress(async ({ cfg, admins, context, activatePolicy }) => {
+    const admin = admins[0]!;
+    cfg.commands!.ownerAllowFrom = ["discord:" + admin.identity.senderId];
+    await activatePolicy({});
+    const ctx = await context(admin.identity.senderId);
+    const operator = expectDefined(
+      prepareInternalGetReplyOptions(undefined, ctx)?.operatorAuthority,
+      "linked authority",
+    );
+    const gateway = createContext();
+    gateway.getRuntimeConfig = () => cfg;
+    gateway.resolveGatewayContext = () => gateway;
+    const browser = vi.fn(({ respond }: GatewayRequestHandlerOptions) =>
+      respond(true, { tabs: [] }),
+    );
+    const children: string[][] = [];
+    const methods = createGatewayMethodRegistry([
+      {
+        name: "browser.request",
+        scope: "operator.admin",
+        owner: { kind: "core", area: "browser" },
+        handler: browser,
+      },
+      {
+        name: "scopeProof.child",
+        scope: "operator.write",
+        owner: { kind: "core", area: "scope-proof" },
+        handler: async ({ client, respond }: GatewayRequestHandlerOptions) => {
+          children.push(client!.connect.scopes!);
+          const result = await dispatchGatewayMethodInProcess(
+            "browser.request",
+            {},
+            {
+              forceSyntheticClient: true,
+              syntheticScopes: ["operator.admin"],
+              syntheticScopeMode: "exact",
+              resolveGatewayContext: () => gateway,
+            },
+          );
+          respond(true, result);
+        },
+      },
+    ]);
+    gateway.getGatewayMethodRegistry = () => methods;
+    const invoke = (method: string) =>
+      dispatchGatewayMethodInProcess(
+        method,
+        {},
+        { forceSyntheticClient: true, resolveGatewayContext: () => gateway },
+      );
+    const held = await withPluginRuntimeGatewayRequestScope(
+      { context: gateway, isWebchatConnect: () => false },
+      () =>
+        withOperatorToolGatewayAuthority(
+          { scopes: operator.scopes, operatorRunAuthority: operator },
+          async () => {
+            await expect(invoke("browser.request")).resolves.toEqual({ tabs: [] });
+            await expect(invoke("scopeProof.child")).resolves.toEqual({ tabs: [] });
+            return await captureOperatorToolGatewayContinuationContext();
+          },
+        ),
+    );
+    expect(children[0]).toContain("operator.admin");
+    expect(held?.operatorAuthority?.scopes).toContain("operator.admin");
+    try {
+      await expect(held!.run(() => invoke("browser.request"))).resolves.toEqual({ tabs: [] });
+      expect(browser).toHaveBeenCalledTimes(3);
+      const narrow = createOperatorClient({
+        profileId: admin.profile.id,
+        scopes: ["operator.write"],
+      });
+      narrow.internal = { operatorRunAuthority: operator };
+      await expect(
+        withPluginRuntimeGatewayRequestScope(
+          { context: gateway, client: narrow, isWebchatConnect: () => false },
+          () =>
+            dispatchGatewayMethodInProcess(
+              "browser.request",
+              {},
+              {
+                forceSyntheticClient: true,
+                syntheticScopes: ["operator.admin"],
+                syntheticScopeMode: "exact",
+                resolveGatewayContext: () => gateway,
+              },
+            ),
+        ),
+      ).rejects.toThrow("missing scope: operator.admin");
+      setUserProfileRole(admin.profile.id, "member");
+      expect(() => held!.run(() => invoke("browser.request"))).toThrow();
+      expect(browser).toHaveBeenCalledTimes(3);
+      expect(getCommandOwnerAuthority(ctx)?.isCurrent()).toBe(true);
+    } finally {
+      held?.release();
+    }
+  });
+});
